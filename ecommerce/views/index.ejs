<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products — E-Commerce App</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1>E-Commerce Store</h1>
    <nav>
      <a href="/">Products</a>
      <a href="/cart">Cart</a>
    </nav>
  </header>
  <main>
    <h2>Products</h2>
    <% if (!db_available) { %>
      <div class="alert">MongoDB is unavailable. Using local sample products only.</div>
    <% } %>
    <div class="products">
      <% products.forEach(product => { %>
        <div class="product">
          <h3><%= product.name %></h3>
          <p><%= product.description %></p>
          <p>Price: $<%= product.price %></p>
          <a href="/add_to_cart/<%= product.id %>" class="btn">Add to Cart</a>
        </div>
      <% }) %>
    </div>
  </main>
  <footer>
    <p>&copy; 2023 E-Commerce App</p>
  </footer>
  <script src="/js/script.js"></script>
</body>
</html>
